# Infrastructure only. Configure AI providers, models, keys, and the default
# provider in the application's Settings page; they are stored in SQLite.
# All settings are optional. Uncomment a setting to override its default.
# Relative paths resolve from the backend process's working directory.

# PORT=3000
# DATABASE_FILE=./receipt-tracker.sqlite

# Default: <repository>/python_worker/.venv/bin/python
# PYTHON_EXECUTABLE=/absolute/path/to/python

# Worker readiness timeout in milliseconds. Default: 180000 (3 minutes).
# Must be an integer between 1 and 2147483647; invalid values fail startup.
# PYTHON_WORKER_START_TIMEOUT_MS=180000

# Default: <repository>/data/scans (temporary scan sessions)
# SCANS_DIR=/absolute/path/to/scans

# Default: <repository>/data/logs/backend.log
# LOG_FILE=/absolute/path/to/backend.log

# Default: $XDG_CONFIG_HOME/receipt-tracker/keys, or
# ~/.config/receipt-tracker/keys when XDG_CONFIG_HOME is unset.
# Must be an absolute path outside the repository. Stores master.key.
# SECRETS_KEY_DIR=/absolute/path/outside-the-repository/receipt-tracker/keys
