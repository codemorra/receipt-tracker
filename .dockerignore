# Send only the inputs used by the image build. Host dependencies, build output,
# data, SQLite files, logs, caches, local configuration and secrets stay outside.
**
!Dockerfile
!.dockerignore
!LICENSE
!package.json
!package-lock.json

!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**

!backend/
!backend/package.json
!backend/package-lock.json
!backend/tsconfig.json
!backend/src/
!backend/src/**
!backend/drizzle/
!backend/drizzle/**

!python_worker/
!python_worker/*.py
!python_worker/requirements.txt

# Keep sensitive or generated files excluded even inside an allowed directory.
**/.env
**/.env.*
**/*.key
**/*.pem
**/master.key
**/node_modules
**/.venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/coverage
**/*.py[cod]
**/*.sqlite*
**/*.log
